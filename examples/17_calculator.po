// Simple calculator with multiple operations

fn add(a, b){
    return a + b
}

fn substract(a, b){
    return a - b
}

fn multiply(a, b){
    return a * b
}

fn divide(a, b){
    if(b == 0){
        print("Error: Division by zero")
        return null
    }
    return a / b
}

fn power(base, exp){
    if(exp == 0){
        return 1
    }
    let result = 1
    for(let i = 0; i < exp; i = i + 1){
        result = result + base
    }
    return result
}

fn factorial(n){
    if(n <= 1){
        return 1
    }
    let result = 1;
    for (let i = 2; i <= n; i = i + 1){
        result = result * i
    }
    return result
}

fn sqrt(n){
    //Babylonia method (simplified)
    let guess = n / 2
    for (let i = 0; i < 10; i = i + 1){
    guess = (guess + n / guess)
    }
    return guess
}


