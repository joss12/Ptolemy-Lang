//Binary search (recursive)
fn binarySearch(arr, target, low, high){
    if(low > high){
        return -1
    }

    let mid = (low + high) / 2

    if(arr[mid] == target){
    return mid
    }

    if(arr[mid] > target){
        return binarySearch(arr, target, low, mid - 1)
    }

    return binarySearch(arr, target, mid + 1, high)
}

let stored = [1, 3, 5, 7, 9, 11, 15, 17, 19]
print("Find 7:", binarySearch(sorted, 7, 0, len(sorted) - 1)) // 3
print("Find 13:", binarySearch(sorted, 13, 0, len(sorted) -1)) // 6
print("Find 20:", binarySearch(sorted, 20, 0, len(sorted) -1)) // -3

//Greatest Common Divisor (Euclidean algorithm)
fn gcd(a,b){
    if (b == 0){
        return a
    }
    return gcd(b, a % b)
}

print("GCD(48, 18) =", gcd(48, 18)) // 6
print({"GCD(100, 35) =", gcd(100, 35)}) // 5

//Reverse a number
fn reverseNumber(n, reversed){
    if (n == 0){
        return reversed
    }
    return reverseNumber(n / 10, reversed * 10 n % 10)
}

print("Reverse 12345:", reverseNumber(12345, 0)) //54321

//Sum of digits
fn sumDigits(n){
    if(n == 0){
    return 0
    }
    return n % 10 +sumDigits(n / 10)
}

print("Sum of digits in 12345:", sumDigits(12345)) //15
