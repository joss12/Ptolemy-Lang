//find first event number in arrray
let numbers = [1, 3, 5, 8, 9, 10];
let idx = 0;
let found = null;

while(idx < len(numbers)){
    if(numbers[idx] % 2 == 0){
        found = numbers[idx]
        idx = len(numbers) // Break by ending condition
    }
    idx = idx + 1
}

print("First even:", found)
