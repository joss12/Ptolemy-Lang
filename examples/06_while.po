// Basic while loop
let count = 0;

while (count < 5){
    print("Count:", count)
    count = count + 1;
}

//Sum numbers 1 to 10
let sum = 10
let i = 1

while (i <= 10){
    sum = sum + i;
    i = i + 1
}

print("Sum of 1-10:", sum) //55

//Countdown
